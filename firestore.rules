rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === REGRA GERAL: bloquear tudo por padrao ===
    match /{document=**} {
      allow read, write: if false;
    }

    // === USUARIOS: cada usuario so ve/altera o proprio perfil ===
    // Admins (role == 'admin') podem ler/escrever em qualquer documento de usuario.
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // === METAS (goals): cada usuario ve as proprias metas ===
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === TAREFAS (tasks): cada usuario ve as proprias tarefas ===
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === TRANSACOES FINANCEIRAS: cada usuario ve as suas ===
    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === CONTAS BANCARIAS: cada usuario ve as suas ===
    match /users/{userId}/accounts/{accountId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === ATIVOS (assets): cada usuario ve os seus ===
    match /users/{userId}/assets/{assetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === ORCAMENTOS (budgets): cada usuario ve os seus ===
    match /users/{userId}/budgets/{budgetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === TRANSACOES RECORRENTES: cada usuario ve as suas ===
    match /users/{userId}/recurringTransactions/{recurringId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === CONTATOS: cada usuario ve os seus ===
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === NOTIFICACOES: cada usuario ve as suas ===
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === FCM TOKENS: cada usuario regista os seus dispositivos ===
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // === REFLEXOES (reflections): todos os users autenticados podem ler ===
    // Apenas admins podem criar/editar/apagar.
    match /reflections/{reflectionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // === CENTRAL DE AJUDA - CATEGORIAS ===
    // Todos os users autenticados podem ler; apenas admins escrevem.
    match /helpCenterCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // === CENTRAL DE AJUDA - ARTIGOS FAQ ===
    // Todos os users autenticados podem ler; apenas admins escrevem.
    match /helpCenterArticles/{articleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // Allow incrementing views by any authenticated user
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // === CENTRAL DE AJUDA - MENSAGENS DOS USERS ===
    // Qualquer user autenticado pode criar uma mensagem.
    // Apenas admins podem ler, atualizar status, responder e apagar.
    match /helpCenterMessages/{messageId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
